<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".GuideCaptureActivity" android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".SshTrustAuthenticationTestActivity"
            android:exported="false" />
        <activity
            android:name=".TerminalSpikeComponentTestActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name=".backup.LocalBackupDocumentsProvider"
            android:authorities="com.yanjiyu.terminalspike.test.backup.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
        <!-- Tests address this provider by URI. Advertising it to DocumentsUI makes
             root discovery race Orchestrator's process teardown and data clearing. -->
        <provider
            android:name=".backup.PrivateKeyPickerDocumentsProvider"
            android:authorities="com.yanjiyu.terminalspike.test.keypicker.documents"
            android:enabled="false"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
