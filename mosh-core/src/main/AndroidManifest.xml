<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>

        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshExtensionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":mosh_broker">
            <meta-data
                android:name="com.yanjiyu.terminalspike.mosh.API_VERSION"
                android:value="1" />
            <meta-data
                android:name="com.yanjiyu.terminalspike.mosh.UPSTREAM_VERSION"
                android:value="1.4.0" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="active user-started Mosh terminal sessions" />
        </service>

        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker0Service"
            android:exported="false"
            android:process=":mosh_session_0" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker1Service"
            android:exported="false"
            android:process=":mosh_session_1" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker2Service"
            android:exported="false"
            android:process=":mosh_session_2" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker3Service"
            android:exported="false"
            android:process=":mosh_session_3" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker4Service"
            android:exported="false"
            android:process=":mosh_session_4" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker5Service"
            android:exported="false"
            android:process=":mosh_session_5" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker6Service"
            android:exported="false"
            android:process=":mosh_session_6" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker7Service"
            android:exported="false"
            android:process=":mosh_session_7" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker8Service"
            android:exported="false"
            android:process=":mosh_session_8" />
        <service
            android:name="com.yanjiyu.terminalspike.mosh.MoshWorker9Service"
            android:exported="false"
            android:process=":mosh_session_9" />
    </application>

</manifest>
