+/* Terminal Spike, 2026-11-07: share long Unix socket aliases between independent PRoot
+ * sessions in the same private temporary directory. Keep normal filesystem
+ * socket lifetime: exiting a client must not unlink a live server's socket. */
+static uint64_t shared_socket_hash(const char *host_path)
+{
+	const unsigned char *cursor;
+	uint64_t hash = UINT64_C(14695981039346656037);
+	for (cursor = (const unsigned char *) host_path; *cursor; ++cursor) {
+		hash ^= *cursor;
+		hash *= UINT64_C(1099511628211);
+	}
+	return hash;
+}
+
+/* Restore a registered alias before filesystem operations, not just connect.
+ * Re-canonicalizing after insertion also follows guest symlinks through aliases
+ * created by another session and lets normal stale-socket unlink work. */
+int restore_shared_socket_binding(Tracee *tracee, const char host_path[PATH_MAX])
+{
+	const char *shared = getenv("PROOT_SHARED_UNIX_SOCKETS");
+	char shorter[PATH_MAX], identity[PATH_MAX], recorded[PATH_MAX];
+	char guest[PATH_MAX];
+	ssize_t length;
+	int status;
+
+	if (shared == NULL || strcmp(shared, "1") != 0 || strlen(host_path) <= sizeof_path)
+		return 0;
+	status = snprintf(shorter, sizeof(shorter), "%s/us-%016" PRIx64,
+		get_temp_directory(), shared_socket_hash(host_path));
+	if (status < 0 || (size_t) status >= sizeof_path)
+		return 0;
+	status = snprintf(identity, sizeof(identity), "%s.path", shorter);
+	if (status < 0 || (size_t) status >= sizeof(identity))
+		return 0;
+	length = readlink(identity, recorded, sizeof(recorded));
+	if (length < 0 || (size_t) length != strlen(host_path)
+	    || memcmp(recorded, host_path, (size_t) length) != 0)
+		return 0;
+	strcpy(guest, host_path);
+	status = detranslate_path(tracee, guest, NULL);
+	if (status < 0)
+		return status;
+	if (insort_binding3(tracee, tracee->ctx, shorter, guest) == NULL)
+		return -ENOMEM;
+	return 1;
+}
+
+static int shared_socket_path(Tracee *tracee, const char *host_path, char **result)
+{
+	uint64_t hash = shared_socket_hash(host_path);
+	char *identity;
+	char recorded[PATH_MAX];
+	ssize_t length;
+
+	*result = talloc_asprintf(tracee->ctx, "%s/us-%016" PRIx64,
+		get_temp_directory(), hash);
+	if (*result == NULL)
+		return -ENOMEM;
+	if (strlen(*result) >= sizeof_path)
+		return -ENAMETOOLONG;
+
+	/* The hash is only a short name, not an identity check. An atomic,
+	 * persistent symlink records the full canonical path; reject a collision
+	 * instead of ever connecting to a different guest socket. */
+	identity = talloc_asprintf(tracee->ctx, "%s.path", *result);
+	if (identity == NULL)
+		return -ENOMEM;
+	if (symlink(host_path, identity) < 0 && errno != EEXIST)
+		return -errno;
+	length = readlink(identity, recorded, sizeof(recorded));
+	if (length < 0)
+		return -errno;
+	if ((size_t) length != strlen(host_path)
+	    || memcmp(recorded, host_path, (size_t) length) != 0)
+		return -EADDRINUSE;
+	return 0;
+}
 
